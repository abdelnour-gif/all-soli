# انسخ هاد الملف لـ .env وبدّل القيم

# ---------- لوحة التحكم ----------
# إذا خليتها فارغة، تتولّد وحدها وتتحفظ في data/admin_password.txt
ADMIN_PASSWORD=
# الرابط العمومي تاع السيرفر (لازم https لتيليغرام وواتساب)
PUBLIC_BASE_URL=http://localhost:8000

# ---------- المحرك ----------
# rules     = المحرك المدمج (بلا نموذج، مجاني، يخدم ديما)
# ollama    = نموذجك المدرَّب (ملف GGUF) على Ollama  ← المستحسن بعد التدريب
# openai    = أي سيرفر متوافق مع OpenAI (vLLM، LM Studio، llama.cpp)
# anthropic = Claude (يحتاج ANTHROPIC_API_KEY)
LLM_PROVIDER=rules

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=darja

OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_API_KEY=
OPENAI_MODEL=darja

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

LLM_TIMEOUT=60
HISTORY_TURNS=10

# ---------- القنوات ----------
# Verify token تاع Meta (واتساب/ماسنجر). إذا فارغ يتولّد وحدو (شوفو في لوحة التحكم)
WA_VERIFY_TOKEN=
# App secret تاع تطبيق Meta (للتأكد بلي الرسائل جاية من فيسبوك بصح) — مستحسن
META_APP_SECRET=
# بوت تيليغرام واحد يبعث التنبيهات لكل أصحاب المحلات (اختياري)
NOTIFY_TELEGRAM_TOKEN=

# ---------- أخرى ----------
PUBLIC_RATE_LIMIT=20
DEBUG=false
